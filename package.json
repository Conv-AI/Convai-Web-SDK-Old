{
  "name": "convai-web-sdk",
  "description": "Integrate lifelike digital beings into your web applications with real-time conversations, actions, and facial expressions. Supports a variety of voices, languages, and emotions.",
  "keywords": [
    "react",
    "unity-webgl",
    "facial expressions",
    "conversational AI",
    "interactive web experiences",
    "interactive avatars"
  ],
  "version": "1.2.0",
  "main": "dist/vanilla/umd/convai-web-client.umd.js",
  "module": "dist/react/esm/convai-web-client-react.js",
  "private": false,
  "browser": "dist/vanilla/umd/convai-web-client.umd.js",
  "types": "dist/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/react/esm/convai-web-client-react.js",
      "require": "./dist/vanilla/umd/convai-web-client.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/esm/convai-web-client-react.js",
      "types": "./dist/types/react.d.ts"
    },
    "./vanilla": {
      "import": "./dist/vanilla/esm/convai-web-client.js",
      "require": "./dist/vanilla/umd/convai-web-client.umd.js",
      "types": "./dist/types/vanilla.d.ts"
    }
  },
  "./proto/*": "./dist/proto/*",
  "./proto/service/*": "./dist/proto/service/*",
  "./proto/service/service_pb": "./dist/proto/service/service_pb",
  "files": [
    "dist",
    "Proto",
    "dist/proto"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "postbootstrap": "npm run lib:build",
    "build": "npm run build:vanilla && npm run build:react && npm run build:types",
    "build:vanilla": "webpack --config webpack.config.vanilla.js",
    "build:react": "webpack --config webpack.config.react.js",
    "build:types": "tsc --project tsconfig.types.json",
    "lib:build": "npm run clean && npm run build && cp -r ./Proto ./dist/proto/"
  },
  "license": "Apache-2.0",
  "author": "Convai Technologies Inc.",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.10.8",
    "@improbable-eng/grpc-web": "^0.15.0",
    "@types/node": "^18.15.1",
    "@types/react": "^18.0.0",
    "axios": "^1.0.0",
    "google-protobuf": "^3.21.2",
    "msr": "^1.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.0",
    "webpack": "^5.76.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.0.1"
  },
  "homepage": "https://github.com/Conv-AI/Convai-Web-SDK",
  "bugs": {
    "url": "https://github.com/Conv-AI/Convai-Web-SDK/issues"
  }
}
